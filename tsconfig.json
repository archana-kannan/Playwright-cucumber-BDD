{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["features/**/*.ts", "stepdefinition/**/*.ts", "steps/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
